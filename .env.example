# Copy to .env and fill in. Everything prefixed EXPO_PUBLIC_ is bundled into the
# app and is PUBLIC — never put secrets here. Leave a value empty ("") to turn
# that online feature off; the app keeps working offline with bundled data.

# Photon-compatible geocoder for address/landmark search (OpenStreetMap data).
# Default: https://photon.komoot.io (fair-use public instance). Self-host for production.
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io

# OSRM-compatible routers used only on the journey-details screen to draw real
# walking/driving paths. Defaults are FOSSGIS public instances (fair use).
EXPO_PUBLIC_WALK_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
EXPO_PUBLIC_DRIVE_ROUTING_URL=https://routing.openstreetmap.de/routed-car

# Raster tile template for the WEB map (Leaflet). OSM's tile server has a
# usage policy — use your own or a commercial provider for production traffic.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional: your Uber developer client_id (public identifier, not a secret).
EXPO_PUBLIC_UBER_CLIENT_ID=

# Build-time only (NOT bundled as EXPO_PUBLIC_): Google Maps SDK key for the
# Android map. Restrict it to package com.viralinbound.hogona + your SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=

# Public support email shown in Privacy & about (and used in the store listings).
EXPO_PUBLIC_SUPPORT_EMAIL=
